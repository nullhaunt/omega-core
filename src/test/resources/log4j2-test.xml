<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="TestConsole" target="SYSTEM_OUT">
            <PatternLayout pattern="%level %logger: %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="WARN">
            <AppenderRef ref="TestConsole"/>
        </Root>
    </Loggers>
</Configuration>
